# The default development paths already work when commands are run through pnpm.
CC_ASSISTANT_DATA_DIR=.data
CC_ASSISTANT_HOST=127.0.0.1
CC_ASSISTANT_PORT=4317
CC_ASSISTANT_DAEMON_URL=http://127.0.0.1:4317

# Normally generated into CC_ASSISTANT_DATA_DIR/access-token on first start.
# CC_ASSISTANT_TOKEN=
