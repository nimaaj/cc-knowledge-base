{
  "name": "@cc-assistant/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "CC_ASSISTANT_DATA_DIR=../../.data tsx watch src/index.ts",
    "start": "CC_ASSISTANT_DATA_DIR=../../.data node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cc-assistant/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@fastify/cookie": "^11.0.0",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  }
}
